# "testnet" (develop here) or "mainnet" (real USDC, irreversible).
NEXT_PUBLIC_ARC_NETWORK=testnet
# Optional RPC override; defaults to the public Arc RPC for the selected network.
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_USDC=0x3600000000000000000000000000000000000000
# ArcwayPassport address ON THE SAME NETWORK as above.
NEXT_PUBLIC_PASSPORT_CONTRACT=
# Optional: where "Get USDC" links. Defaults: Circle faucet (testnet), Arc Portal (mainnet).
NEXT_PUBLIC_BRIDGE_URL=
# Optional: public site URL for share images (Vercel sets its own by default).
NEXT_PUBLIC_SITE_URL=
# Optional: where Terms/Privacy "Contact" points.
NEXT_PUBLIC_CONTACT_URL=

# Server-only. Verifier signer allowed to call ArcwayPassport.completeQuest.
# Needs a little USDC for fees. Never prefix with NEXT_PUBLIC_.
VERIFIER_PRIVATE_KEY=
# Optional: Blockscout Pro API key if the explorer starts rate-limiting activity.
EXPLORER_API_KEY=

# Optional: passkey wallets (Circle Modular Wallets). Client Key from the Circle Console
# (Keys > Client Keys), with this site's domain added as the passkey domain, and a Gas Station
# policy for Arc so new wallets can transact without USDC for fees.
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
# Optional overrides. The chain name is Circle's path for the network ("arcTestnet" on testnet).
NEXT_PUBLIC_CIRCLE_CLIENT_URL=
NEXT_PUBLIC_CIRCLE_CHAIN=

# Optional, server-only: GraphQL endpoint of Arcway's Envio indexer (see /indexer).
# When unset or unreachable, passport stats are read from the Arc explorer instead.
ARCWAY_INDEXER_URL=

# Optional: ArcwayCampaigns escrow ON THE SAME NETWORK (see contracts/script/DeployCampaigns.s.sol).
# Until set, projects can prepare and preview campaigns but not launch them.
# The same VERIFIER_PRIVATE_KEY signs campaign entries and publishes draw results.
NEXT_PUBLIC_CAMPAIGNS_CONTRACT=
