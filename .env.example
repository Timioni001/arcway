# "testnet" (default, develop here) or "mainnet" (real USDC, irreversible).
NEXT_PUBLIC_ARC_NETWORK=testnet
# Optional RPC override; defaults to the public Arc RPC for the selected network.
NEXT_PUBLIC_ARC_RPC_URL=
NEXT_PUBLIC_ARC_USDC=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_PASSPORT_CONTRACT=
# Optional: where "Bring USDC" links. Defaults to Circle's faucet on testnet.
NEXT_PUBLIC_BRIDGE_URL=

# Server-only. Verifier signer allowed to call ArcwayPassport.completeQuest.
# Leave empty to run with recording disabled. Never prefix with NEXT_PUBLIC_.
VERIFIER_PRIVATE_KEY=
